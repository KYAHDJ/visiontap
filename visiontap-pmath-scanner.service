[Unit]
Description=VisionTap dedicated PayMath scanner
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/VisionTap/pcapp/scanner
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Manila
Environment=VT_SCANNER_PORT=5567
Environment=VT_OCR_TIMEOUT=5
ExecStart=/home/opc/VisionTap/.venv/bin/python server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
