[Unit]
Description=VisionTap Electron App - Slow Instance (Right Small, 5s delay, new account)
After=network.target visiontap-xvfb.service visiontap-scanner.service visiontap-electron.service
Requires=visiontap-xvfb.service

[Service]
Type=simple
User=opc
Environment=DISPLAY=:1
Environment=VISIONTAP_SLOW=1
WorkingDirectory=/home/opc/VisionTap/slotbrowser
ExecStart=/usr/bin/npx electron . --no-sandbox --slow
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
