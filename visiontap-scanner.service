[Unit]
Description=VisionTap Scanner
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/VisionTap/pcapp/scanner
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Manila
ExecStart=/home/opc/VisionTap/.venv/bin/python server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
