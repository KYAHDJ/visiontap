{
  "manifest_version": 3,
  "name": "VisionTap - Local Scanner",
  "description": "Automated ECNL solver using local OpenCV image detection (Alt+M).",
  "version": "2.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "windows",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:5555/*",
    "http://localhost:5555/*",
    "http://localhost:8177/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "trigger-scan": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Scan ECNL image and auto-fill answer"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://ecnlmediamarket.com/*", "http://ecnlmediamarket.com/*"],
      "js": ["task_script.js"],
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["ad_blocker.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
