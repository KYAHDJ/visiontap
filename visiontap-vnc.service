[Unit]
Description=VisionTap Local Automation Viewer
After=visiontap-xvfb.service visiontap-openbox.service
Requires=visiontap-xvfb.service

[Service]
Type=simple
User=opc
ExecStart=/usr/bin/x11vnc -display :1 -localhost -forever -shared -nopw -rfbport 1919
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
