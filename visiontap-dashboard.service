[Unit]
Description=VisionTap Dashboard
After=network.target visiontap-scanner.service

[Service]
Type=simple
User=opc
Environment=TZ=Asia/Manila
Environment=VT_DASHBOARD_READ_ONLY=1
WorkingDirectory=/home/opc/VisionTap/slotbrowser
ExecStart=/usr/bin/node dashboard.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
