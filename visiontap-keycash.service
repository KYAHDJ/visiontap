[Unit]
Description=VisionTap isolated KeyCash typing worker
After=network-online.target visiontap-xvfb.service visiontap-openbox.service
Wants=network-online.target
Requires=visiontap-xvfb.service visiontap-openbox.service

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/VisionTap/slotbrowser
Environment=DISPLAY=:1
Environment=VT_KEYCASH_HEADLESS=0
Environment=VT_KEYCASH_LOAD_LIMIT=18
Environment=VT_KEYCASH_MEMORY_FLOOR_MB=1024
ExecStart=/usr/bin/node /home/opc/VisionTap/slotbrowser/keycash-worker.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=25
KillMode=mixed
Nice=10
CPUQuota=70%
MemoryMax=900M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
