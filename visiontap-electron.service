[Unit]
Description=VisionTap Electron App
After=network.target visiontap-xvfb.service visiontap-scanner.service
Requires=visiontap-xvfb.service

[Service]
Type=simple
User=opc
Environment=DISPLAY=:1
WorkingDirectory=/home/opc/VisionTap/slotbrowser
ExecStart=/usr/bin/npx electron . --no-sandbox
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
